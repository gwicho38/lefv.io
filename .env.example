# Local Database URL (used when USE_SUPABASE=false)
DATABASE_URL=postgresql://REDACTED

# Supabase Configuration
USE_SUPABASE=false

# Next.js public Supabase variables
NEXT_PUBLIC_SUPABASE_URL=https://REDACTED-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Development Environment
SUPABASE_URL_DEV=https://REDACTED-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY_DEV=your-dev-anon-key

# Supabase PostgreSQL connection strings (for migrations)
# Get these from Supabase Dashboard > Project Settings > Database > Connection string > URI format
SUPABASE_POSTGRES_URL_DEV=postgresql://REDACTED

# Supabase Production Environment
SUPABASE_URL_PROD=https://REDACTED-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY_PROD=your-prod-anon-key
SUPABASE_POSTGRES_URL_PROD=postgresql://REDACTED

# Environment (development or production)
NODE_ENV=development