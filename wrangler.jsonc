{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lefv-io",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // Routes, not a custom domain: the zone's DNS records still point at
  // lefv-tunnel, and a route intercepts at the edge without touching them.
  "routes": [
    { "pattern": "lefv.io/*", "zone_name": "lefv.io" },
    { "pattern": "www.lefv.io/*", "zone_name": "lefv.io" }
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
